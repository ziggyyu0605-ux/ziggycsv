7 To implement various primitive operations on fuzzy sets Union, Intersection &
Complement.

A = {'a': 0.2, 'b': 0.3, 'c': 0.6, 'd': 0.6}
B = {'a': 0.9, 'b': 0.6, 'c': 0.4, 'd': 0.5}

# Union
union = {k: max(A[k], B[k]) for k in A}

# Intersection
intersection = {k: min(A[k], B[k]) for k in A}

# Complement
complement = {k: 1-A[k] for k in A}

# Scalar multiplication
scalar = {k: min(1, 0.5*A[k]) for k in A}

# Fuzzy addition
addition = {k: min(1, A[k]+B[k]) for k in A}

# Fuzzy subtraction
subtraction = {k: max(0, A[k]-B[k]) for k in A}

print("Union:", union)
print("Intersection:", intersection)
print("Complement:", complement)
print("Scalar Multiplication:", scalar)
print("Fuzzy Addition:", addition)
print("Fuzzy Subtraction:", subtraction)

