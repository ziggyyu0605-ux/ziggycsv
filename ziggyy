10 To implement the Depth First Search (DFS) to traverse a graph or tree in depth-first 
order

g={'A':['B','C'],'B':['D','E'],'C':['F'],
   'D':[],'E':['F'],'F':[]}

s=['A']
v=[]

while s:
    n=s.pop()
    if n not in v:
        v.append(n)
        s+=g[n]

print("Depth First Search:")
print(*v,sep='\n')

11 To implement the Breadth First Search (BFS) to traverse a graph or tree in Breadth-first
order

from collections import deque

g={'A':['B','C'],'B':['D','E'],'C':['F'],'D':[],'E':['F'],'F':[]}
q=deque('A')
v=[]

while q:
 n=q.popleft()
 if n not in v:
  v.append(n)
  q.extend(g[n])

print("Breadth First Search:")
print(*v,sep='\n')
